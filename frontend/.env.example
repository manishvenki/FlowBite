# BiteFlow Frontend Environment Variables Example
# Localhost Development:
VITE_API_URL=http://localhost:5000/api

# Local Network / LAN Access (Optional - auto-detects browser hostname if omitted):
# VITE_API_URL=http://192.168.1.10:5000/api

# Production / Vercel:
# VITE_API_URL=https://your-biteflow-backend.vercel.app/api
