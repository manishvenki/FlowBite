# ========================================================
# BiteFlow — Root .gitignore
# ========================================================

# Dependencies
node_modules/
**/node_modules/
.pnp
.pnp.js

# Production & Build Outputs
dist/
**/dist/
dist-ssr/
**/dist-ssr/
build/
out/

# TypeScript & Bundler Cache
*.tsbuildinfo
.vite/
**/.vite/
.eslintcache
.cache/
.turbo/

# Environment Variables & Secrets
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
**/.env
**/.env.*
**/.env.local
**/.env.development.local
**/.env.test.local
**/.env.production.local
credentials.*
credentials/
[Cc]redentials.*
[Cc]redentials/

# Preserve example environment templates
!.env.example
!**/.env.example

# Logs & Debugging
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
[Tt]humbs.db
Thumbs.db:encryptable
desktop.ini

# Editor & IDE Configs
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.bak
*~

# Temporary Files
*.tmp
*.temp
