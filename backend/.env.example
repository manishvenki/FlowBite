# Server Configuration
PORT=5000
HOST=0.0.0.0
NODE_ENV=development

# Database Connection (Local or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/biteflow

# Authentication
JWT_SECRET=YOUR_SECURE_JWT_SECRET

# CORS Configuration
# In dev, private LAN IPs (192.168.*, 10.*, 172.16-31.*) and localhost are permitted automatically.
# In production, set your specific frontend domain(s):
CORS_ORIGIN=http://localhost:5173,https://your-biteflow-frontend.vercel.app

# SMTP Email Configuration (Nodemailer)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASSWORD=your_smtp_password
MAIL_FROM=BiteFlow Dining <orders@biteflow.com>
